<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns="http://www.springframework.org/schema/beans"
       xsi:schemaLocation="http://www.springframework.org/schema/beans https://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="org.sakaiproject.springframework.orm.hibernate.AdditionalHibernateMappings.videoTraining"
          class="org.sakaiproject.springframework.orm.hibernate.impl.AdditionalHibernateMappingsImpl">
        <property name="annotatedClasses">
            <list>
                <value>org.sakaiproject.videotraining.api.model.VideoTrainingVideo</value>
                                <value>org.sakaiproject.videotraining.api.model.VideoTrainingProcessJob</value>
                <value>org.sakaiproject.videotraining.api.model.VideoTrainingOAuthCredentials</value>
                <value>org.sakaiproject.videotraining.api.model.VideoTrainingCaption</value>
                <value>org.sakaiproject.videotraining.api.model.VideoTrainingAnalyticsEvent</value>
                <value>org.sakaiproject.videotraining.api.model.VideoTrainingCategory</value>
                <value>org.sakaiproject.videotraining.api.model.VideoTrainingLessonLink</value>
                <value>org.sakaiproject.videotraining.api.model.VideoTrainingUserVideoPreference</value>
            </list>
        </property>
    </bean>

        <bean id="org.sakaiproject.videotraining.api.repository.VideoTrainingVideoRepository"
                    class="org.sakaiproject.videotraining.impl.repository.VideoTrainingVideoRepositoryImpl">
                <property name="sessionFactory" ref="org.sakaiproject.springframework.orm.hibernate.GlobalSessionFactory"/>
        </bean>

        <bean id="org.sakaiproject.videotraining.api.repository.VideoTrainingCaptionRepository"
                    class="org.sakaiproject.videotraining.impl.repository.VideoTrainingCaptionRepositoryImpl">
                <property name="sessionFactory" ref="org.sakaiproject.springframework.orm.hibernate.GlobalSessionFactory"/>
        </bean>

        <bean id="org.sakaiproject.videotraining.api.repository.VideoTrainingAnalyticsEventRepository"
                    class="org.sakaiproject.videotraining.impl.repository.VideoTrainingAnalyticsEventRepositoryImpl">
                <property name="sessionFactory" ref="org.sakaiproject.springframework.orm.hibernate.GlobalSessionFactory"/>
        </bean>

        <bean id="org.sakaiproject.videotraining.api.repository.VideoTrainingProcessJobRepository"
                class="org.sakaiproject.videotraining.impl.repository.VideoTrainingProcessJobRepositoryImpl">
            <property name="sessionFactory" ref="org.sakaiproject.springframework.orm.hibernate.GlobalSessionFactory"/>
        </bean>

        <bean id="org.sakaiproject.videotraining.api.repository.VideoTrainingOAuthCredentialsRepository"
                class="org.sakaiproject.videotraining.impl.repository.VideoTrainingOAuthCredentialsRepositoryImpl">
            <property name="sessionFactory" ref="org.sakaiproject.springframework.orm.hibernate.GlobalSessionFactory"/>
        </bean>

        <bean id="org.sakaiproject.videotraining.api.repository.VideoTrainingCategoryRepository"
                class="org.sakaiproject.videotraining.impl.repository.VideoTrainingCategoryRepositoryImpl">
            <property name="sessionFactory" ref="org.sakaiproject.springframework.orm.hibernate.GlobalSessionFactory"/>
        </bean>

        <bean id="org.sakaiproject.videotraining.api.repository.VideoTrainingLessonLinkRepository"
                class="org.sakaiproject.videotraining.impl.repository.VideoTrainingLessonLinkRepositoryImpl">
            <property name="sessionFactory" ref="org.sakaiproject.springframework.orm.hibernate.GlobalSessionFactory"/>
        </bean>

        <bean id="org.sakaiproject.videotraining.api.repository.VideoTrainingUserVideoPreferenceRepository"
                class="org.sakaiproject.videotraining.impl.repository.VideoTrainingUserVideoPreferenceRepositoryImpl">
            <property name="sessionFactory" ref="org.sakaiproject.springframework.orm.hibernate.GlobalSessionFactory"/>
        </bean>

    <bean id="org.sakaiproject.videotraining.api.service.VideoTrainingService"
          class="org.sakaiproject.videotraining.impl.service.VideoTrainingServiceImpl"
          init-method="init">
                <property name="videoRepository" ref="org.sakaiproject.videotraining.api.repository.VideoTrainingVideoRepository"/>
                <property name="captionRepository" ref="org.sakaiproject.videotraining.api.repository.VideoTrainingCaptionRepository"/>
                <property name="analyticsEventRepository" ref="org.sakaiproject.videotraining.api.repository.VideoTrainingAnalyticsEventRepository"/>
            <property name="categoryRepository" ref="org.sakaiproject.videotraining.api.repository.VideoTrainingCategoryRepository"/>
            <property name="lessonLinkRepository" ref="org.sakaiproject.videotraining.api.repository.VideoTrainingLessonLinkRepository"/>
            <property name="userVideoPreferenceRepository" ref="org.sakaiproject.videotraining.api.repository.VideoTrainingUserVideoPreferenceRepository"/>
            <property name="contentHostingService" ref="org.sakaiproject.content.api.ContentHostingService"/>
            <property name="eventTrackingService" ref="org.sakaiproject.event.api.EventTrackingService"/>
        <property name="functionManager" ref="org.sakaiproject.authz.api.FunctionManager"/>
        <property name="securityService" ref="org.sakaiproject.authz.api.SecurityService"/>
        <property name="sessionManager" ref="org.sakaiproject.tool.api.SessionManager"/>
        <property name="siteService" ref="org.sakaiproject.site.api.SiteService"/>
            <property name="memoryService" ref="org.sakaiproject.memory.api.MemoryService"/>
    </bean>

        <bean id="org.sakaiproject.videotraining.api.service.VideoTrainingOAuthCredentialsService"
                    class="org.sakaiproject.videotraining.impl.service.VideoTrainingOAuthCredentialsServiceImpl">
                <property name="credentialsRepository" ref="org.sakaiproject.videotraining.api.repository.VideoTrainingOAuthCredentialsRepository"/>
        </bean>

    <!-- Job to print external video links -->
    <bean id="ExternalLinkVideoJob" class="org.sakaiproject.videotraining.services.ExternalLinkVideoJob">
        <property name="videoRepository" ref="org.sakaiproject.videotraining.api.repository.VideoTrainingVideoRepository"/>
        <property name="sessionManager" ref="org.sakaiproject.tool.api.SessionManager"/>
        <property name="emailService" ref="org.sakaiproject.email.api.EmailService"/>
        <property name="userDirectoryService" ref="org.sakaiproject.user.api.UserDirectoryService"/>
        <property name="serverConfigurationService" ref="org.sakaiproject.component.api.ServerConfigurationService"/>
    </bean>

    <bean id="HlsTranscodingJob" class="org.sakaiproject.videotraining.services.HlsTranscodingJob">
        <property name="videoRepository" ref="org.sakaiproject.videotraining.api.repository.VideoTrainingVideoRepository"/>
        <property name="processJobRepository" ref="org.sakaiproject.videotraining.api.repository.VideoTrainingProcessJobRepository"/>
        <property name="videoTrainingService" ref="org.sakaiproject.videotraining.api.service.VideoTrainingService"/>
        <property name="contentHostingService" ref="org.sakaiproject.content.api.ContentHostingService"/>
        <property name="sessionManager" ref="org.sakaiproject.tool.api.SessionManager"/>
        <property name="emailService" ref="org.sakaiproject.email.api.EmailService"/>
        <property name="userDirectoryService" ref="org.sakaiproject.user.api.UserDirectoryService"/>
        <property name="serverConfigurationService" ref="org.sakaiproject.component.api.ServerConfigurationService"/>
    </bean>

    <bean id="ExternalUploadJob" class="org.sakaiproject.videotraining.services.ExternalUploadJob">
        <property name="videoRepository" ref="org.sakaiproject.videotraining.api.repository.VideoTrainingVideoRepository"/>
        <property name="processJobRepository" ref="org.sakaiproject.videotraining.api.repository.VideoTrainingProcessJobRepository"/>
        <property name="credentialsService" ref="org.sakaiproject.videotraining.api.service.VideoTrainingOAuthCredentialsService"/>
        <property name="sessionManager" ref="org.sakaiproject.tool.api.SessionManager"/>
    </bean>

    <bean id="org.sakaiproject.api.app.scheduler.JobBeanWrapper.ExternalLinkVideoJob"
                class="org.sakaiproject.component.app.scheduler.jobs.SpringStatefulJobBeanWrapper"
                init-method="init">
            <property name="beanId" value="ExternalLinkVideoJob"/>
            <property name="jobName" value="External Link Video Job"/>
            <property name="schedulerManager" ref="org.sakaiproject.api.app.scheduler.SchedulerManager" />
    </bean>

</beans>
